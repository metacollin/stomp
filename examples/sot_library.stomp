  "SOT-23-5"         1.6   2.9   1.45  2.8   0.95  0.4   0.45
  "TSOT-23-5"        1.6   2.9   1.0   2.8   0.95  0.4   0.4
  "SOT-353_SC-70-5"  1.25  2.0   1.0   2.1   0.65  0.2   0.3
end

