# DO-41 — an axial diode: the cylinder lies along its leads, which leave its ends and bend down through the board.

footprint "D_DO-41_P10.16mm_Horizontal" {
  description "DO-41 (SOD-81) axial diode, 10.16 mm lead spacing"
  refdes "D"

  body cylinder d 2.7 h 5.2         # the pins sit outside the circle, so it lies down
  pins 2 horizontal pitch 10.16
  lead wire d 0.86
  polarized                         # pin 1 = anode; the band marks the cathode, pin 2
}
