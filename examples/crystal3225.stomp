# Crystal, 3225 — a ceramic package with a metal lid: `model` adds what the lead form can't say.

footprint "Crystal_SMD_3225-4Pin_3.2x2.5mm" {
  description "SMD crystal, 3.2 x 2.5 mm ceramic package, 4 contacts"
  refdes "Y"

  body 3.2 x 2.5 x 0.8              # 0.8 mm seated height, lid included
  pins {
    bottom: 1, 2 pitch 2.2          # pin 1 bottom left, then counter-clockwise
    top: 3, 4
  }
  lead flat 1.4 x 1.1               # contacts at the package edge; the lands follow
  pin1 none

  model {
    height 0.7                      # the ceramic base; the lid makes up the last 0.1
    body color ceramic
    box 2.9 x 2.2 x 0.1 on body color tin    # the seam-welded lid
  }
}
