# TSSOP-20 — letter dimensions transcribed verbatim from a JEDEC MO-153
# style drawing, then a hand-solder variant by inheritance.

let e  = 0.65        # lead pitch
let D  = 6.5         # body length
let E1 = 4.4         # body width
let E  = 6.4         # lead span, outer edge to outer edge
let b  = 0.25        # lead width
let L  = 0.6         # foot length

footprint "TSSOP-20" {
  refdes "U"

  body E1 x D x 1.2
  pins 20 dual pitch e
  lead gullwing b x L span E
  pin1 dot
}

footprint "TSSOP-20-HS" extends "TSSOP-20" {
  description "hand-solder variant: longer pads, roomier courtyard"
  default pad rect 0.4 x 1.8
  courtyard auto 0.5
}
