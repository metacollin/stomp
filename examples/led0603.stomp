# LED, 0603: polarized two-terminal part with extra silkscreen.

footprint "LED0603" {
  description "LED 0603; pin 1 = anode, pin 2 = cathode"
  refdes "D"

  body 1.6 x 0.8 x 0.7
  pins 2 horizontal
  lead endcap 0.3
  density nominal
  polarized                    # cathode bar on silk, stripe on the 3D body

  # A silk block adds to the automatic silk (SPEC 12)
  silk {
    text ">K" at (1.9, 0) size 0.5      # cathode label right of the part
  }
}
