# Crystal and oscillator library: SMD packages with four pads.
#
# Each row is a ceramic package D x E x H with four contacts, b x L at the body
# edges and P apart. Pin 1 is at the bottom left, then counterclockwise. The
# model is a ceramic base with a metal lid. Values are typical; check your
# part's datasheet.

template quartz(code, D, E, H, b, L, P, prefix = "Y", kind = "Crystal") {
  name "{kind}_SMD_{code}-4Pin_{D:.1}x{E:.1}mm"
  description "{kind}, {D:.1} x {E:.1} mm ceramic package, 4 pads"
  refdes "{prefix}"

  body D x E x H
  pins {
    bottom: 1, 2 pitch P
    top: 3, 4
  }
  lead flat b x L                     # contacts at the package edge
  pin1 none

  model {
    height H - 0.1                    # the base; the lid adds 0.1
    body color ceramic
    box (D - 0.3) x (E - 0.3) x 0.1 on body color tin
  }
}

footprints from quartz {
  code    D     E     H     b     L     P
  "2016"  2.0   1.6   0.5   0.65  0.5   1.3
  "2520"  2.5   2.0   0.55  0.85  0.65  1.65
  "3225"  3.2   2.5   0.7   1.2   0.9   2.0
  "5032"  5.0   3.2   1.0   1.6   1.2   3.4
  "7050"  7.0   5.0   1.3   2.0   1.4   5.0
}

# Oscillators in the same packages: pin 1 enable, 2 ground, 3 output, 4 supply
footprints from quartz(prefix = "X", kind = "Oscillator") {
  code    D     E     H     b     L     P
  "2520"  2.5   2.0   0.8   0.85  0.65  1.65
  "3225"  3.2   2.5   1.0   1.2   0.9   2.0
  "5032"  5.0   3.2   1.2   1.6   1.2   3.4
  "7050"  7.0   5.0   1.5   2.0   1.4   5.0
}
