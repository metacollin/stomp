# Diode library: SOD, flat-lead SOD and SMF, SMA/SMB/SMC and MELF packages.
#
# Pin 1 is the anode and pin 2 the cathode, and `polarized` puts the cathode
# band on pin 2's side. Bodies are L x W x H with the pins along L. Four lead
# forms: gull-wing, straight (flat leads out of the bottom of the body), inward
# L-bend and end caps. Values are typical; check your part's datasheet.

# Small plastic packages with short leads at each end: S is the span tip to tip,
# b x f the lead width and foot length.
template sod(pkg, L, W, H, S, b, f) {
  name "D_{pkg}"
  description "Diode, {pkg}, {L} x {W} mm body"
  refdes "D"

  body L x W x H
  pins 2 horizontal
  lead gullwing b x f span S
  polarized
}

# Flat leads straight out of the bottom of the body (SOD-123F, SMF)
template sodf(pkg, L, W, H, S, b, f) {
  name "D_{pkg}"
  description "Diode, {pkg}, {L} x {W} mm body, flat leads"
  refdes "D"

  body L x W x H
  pins 2 horizontal
  lead straight b x f span S
  polarized
}

# Molded packages whose leads fold under the body (JEDEC DO-214)
template smx(pkg, jedec, L, W, H, S, b, f) {
  name "D_{pkg}"
  description "Diode, {pkg} ({jedec}), {L} x {W} mm body"
  refdes "D"

  body L x W x H
  pins 2 horizontal
  lead lbend b x f span S
  polarized
}

# Glass MELF: a cylinder D across and L long, lying on its two end caps
template melf(pkg, L, D, T) {
  name "D_{pkg}"
  description "Diode, {pkg}, {D} mm x {L} mm glass body"
  refdes "D"

  body cylinder d D h L
  pins 2 horizontal
  lead endcap T
  polarized
}

footprints from sod {
  pkg        L     W     H     S     b     f
  "SOD-123"  2.7   1.6   1.15  3.7   0.55  0.4
  "SOD-323"  1.7   1.25  0.95  2.5   0.3   0.3
  "SOD-523"  1.2   0.8   0.6   1.6   0.3   0.2
}

