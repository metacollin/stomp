# Chip passives library: resistors, capacitors and inductors in the common EIA sizes.
#
# One template makes all three. Each row is one case size: its inch and metric
# codes, the body's length L, width W and height H, and the end cap length T.
# The pads are derived from the caps. The refdes letter picks the 3D colors.
# Values are typical; check your part's datasheet.

template chip(code, metric, L, W, H, T, prefix = "R", kind = "Resistor")
  name: "{prefix}_{code}_{metric}Metric"
  description: "{kind}, {code} ({metric} metric), {L} x {W} mm"
  refdes: "{prefix}"
  tags: chip, passive

  body L x W x H
  pins 2 horizontal                   # pin 1 left
  lead endcap T
end

# Thick-film resistors. The codes are quoted so "0402" keeps its leading zero.
footprints from chip
  code    metric  L     W     H     T
  "0201"  "0603"  0.6   0.3   0.23  0.15
  "0402"  "1005"  1.0   0.5   0.35  0.25
  "0603"  "1608"  1.6   0.8   0.45  0.3
  "0805"  "2012"  2.0   1.25  0.5   0.4
  "1206"  "3216"  3.2   1.6   0.55  0.45
  "1210"  "3225"  3.2   2.5   0.55  0.5
  "2010"  "5025"  5.0   2.5   0.55  0.6
  "2512"  "6332"  6.35  3.2   0.55  0.6
end

# Ceramic capacitors (MLCC). H is the thickest common part in each size.
footprints from chip(prefix: "C", kind: "Capacitor")
  code    metric  L     W     H     T
  "0201"  "0603"  0.6   0.3   0.3   0.15
  "0402"  "1005"  1.0   0.5   0.5   0.25
  "0603"  "1608"  1.6   0.8   0.8   0.35
  "0805"  "2012"  2.0   1.25  1.25  0.5
  "1206"  "3216"  3.2   1.6   1.6   0.5
  "1210"  "3225"  3.2   2.5   2.5   0.5
  "1812"  "4532"  4.5   3.2   2.5   0.6
  "2220"  "5750"  5.7   5.0   2.5   0.6
end

# Multilayer inductors and ferrite beads
footprints from chip(prefix: "L", kind: "Inductor")
  code    metric  L     W     H     T
  "0402"  "1005"  1.0   0.5   0.5   0.25
  "0603"  "1608"  1.6   0.8   0.8   0.3
  "0805"  "2012"  2.0   1.25  0.85  0.5
  "1206"  "3216"  3.2   1.6   1.1   0.5
end
