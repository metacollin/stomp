# SOT library: SOT-23, SC-70 and smaller gull-wing transistor packages.
#
# One template per pin layout. Columns use the JEDEC letters:
#
#   E1 x D    body, across the lead rows x along them      A   height
#   E         lead span, tip to tip                         e   pitch
#   b x L     lead width x foot length
#
# Values are typical; check your part's datasheet.

# Three pins: 1 and 2 on the left, 3 alone on the right
template sot3(pkg, E1, D, A, E, e, b, L)
  name: "{pkg}"
  description: "{pkg}, 3 pins, {E1} x {D} mm body"
  refdes: "Q"

  body E1 x D x A
  pins
    left: 1, 2 pitch: 2 * e           # pins 1 and 2 are two pitches apart
    right: 3
  end
  lead gullwing b x L span: E
  pin1: dot
end

# Five pins: three on the left, two on the right at the outer positions
template sot5(pkg, E1, D, A, E, e, b, L)
  name: "{pkg}"
  description: "{pkg}, 5 pins, {E1} x {D} mm body"
  refdes: "U"

  body E1 x D x A
  pins
    left: 1, 2, 3 pitch: e
    right: 4, nc, 5
  end
  lead gullwing b x L span: E
  pin1: dot
end

# Six pins, three per side
template sot6(pkg, E1, D, A, E, e, b, L)
  name: "{pkg}"
  description: "{pkg}, 6 pins, {E1} x {D} mm body"
  refdes: "U"

  body E1 x D x A
  pins 6 dual pitch: e
  lead gullwing b x L span: E
  pin1: dot
end

footprints from sot3
  pkg                E1    D     A     E     e     b     L
  "SOT-23"           1.3   2.9   1.1   2.4   0.95  0.4   0.4
  "SOT-323_SC-70"    1.25  2.0   1.0   2.1   0.65  0.3   0.3
  "SOT-523"          0.8   1.6   0.8   1.6   0.5   0.2   0.2
end

